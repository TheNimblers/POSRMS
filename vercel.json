{
  "version": 2,
  "framework": "vite",
  "buildCommand": "rm -rf dist && pnpm build:client",
  "outputDirectory": "dist/spa",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "env": {
    "NODE_ENV": "production"
  },
  "env_disabled": {
    "MONGODB_URI": {
      "description": "MongoDB connection (deprecated - using Supabase instead)"
    }
  }
}
